{
  "name": "workspacefpv",
  "version": "0.6.3",
  "//appId": "appId stays app.rotorlab on purpose: the NSIS installer and auto-updater identify the existing install by it, so 0.2.0 upgrades in place after the rename to WorkspaceFPV. Do not change.",
  "description": "WorkspaceFPV - diagnose and fix FPV drones running Betaflight, with an AI assistant",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "WorkspaceFPV",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "tsc --noEmit -p app/tsconfig.json && vite build --config vite.config.ts",
    "build:electron": "npm run build && node scripts/build-electron.mjs",
    "dist:win": "npm run build:electron && electron-builder --win nsis --publish never",
    "preview": "vite preview --config vite.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit -p app/tsconfig.json && tsc --noEmit -p electron/tsconfig.json"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@google/genai": "^3.3.0",
    "@types/node": "^26.6.6",
    "@types/three": "0.187.0",
    "@types/w3c-web-serial": "^1.0.9",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "polygon-clipping": "^0.15.7",
    "sharp": "^0.35.5",
    "three": "0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "app.rotorlab",
    "productName": "WorkspaceFPV",
    "copyright": "MIT",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "assets/icon.png"
    ],
    "artifactName": "WorkspaceFPV-Setup.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "WorkspaceFPV"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "0nskal",
        "repo": "WorkspaceFPV",
        "releaseType": "release"
      }
    ]
  }
}
